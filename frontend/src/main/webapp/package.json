{
  "name": "@tafel/admin",
  "version": "0.0.1",
  "description": "Tafel Admin",
  "contributors": [
    {
      "name": "Stephan Prantl"
    }
  ],
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --host=0.0.0.0 --configuration=development",
    "build-local": "ng build --progress",
    "build-prod": "ng build --configuration=production --progress",
    "test": "ng test",
    "test-ci": "ng test --watch=false",
    "lint": "ng lint",
    "cy:run-ci": "wait-on -l -d 10000 tcp:8080 && cypress run --browser chrome --config baseUrl=http://localhost:8080/",
    "cy:run-ci-local": "wait-on -l -d 10000 tcp:4200 && cypress run --browser chrome --config baseUrl=http://localhost:4200/",
    "cy:open-ci": "cypress open --browser chrome --config baseUrl=http://localhost:8080/",
    "cy:open-local": "cypress open --browser chrome"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.0.7",
    "@angular/cdk": "22.0.5",
    "@angular/common": "22.0.7",
    "@angular/compiler": "22.0.7",
    "@angular/core": "22.0.7",
    "@angular/forms": "22.0.7",
    "@angular/localize": "22.0.7",
    "@angular/material": "22.0.5",
    "@angular/platform-browser": "22.0.7",
    "@angular/router": "22.0.7",
    "@fortawesome/angular-fontawesome": "5.1.0",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "chart.js": "4.5.1",
    "core-js": "3.49.0",
    "html5-qrcode": "2.3.8",
    "moment": "2.30.1",
    "ng2-charts": "10.0.0",
    "ngx-cookie-service": "22.0.0",
    "ngx-scrollbar": "19.1.5",
    "postcss": "8.5.22",
    "rxjs": "7.8.2",
    "tailwindcss": "4.3.3",
    "toastr": "2.1.4",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@angular-eslint/builder": "22.1.0",
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/schematics": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/build": "22.0.7",
    "@angular/cli": "22.0.7",
    "@angular/compiler-cli": "22.0.7",
    "@angular/language-service": "22.0.7",
    "@types/node": "26.1.1",
    "@types/toastr": "2.1.43",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitest/browser-playwright": "4.1.10",
    "angular-eslint": "22.1.0",
    "cypress": "15.19.0",
    "cypress-browser-permissions": "1.1.0",
    "cypress-recurse": "1.37.2",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "29.1.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0",
    "npm": ">=11.17.0"
  },
  "allowScripts": {
    "core-js@3.49.0": true,
    "cypress@15.18.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "lmdb@3.5.4": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.5.6": true
  }
}
