### List households
GET {{baseApiPath}}/households?pageIndex=3

### Search for households (name, address, phone, e-mail or household number - fuzzy)
GET {{baseApiPath}}/households?searchInput=muster

### Search for households (fuzzy search combined with the filters)
GET {{baseApiPath}}/households?searchInput=muster&valid=true&costContribution=true

### Validate household
POST {{baseApiPath}}/households/validate
Content-Type: application/json

{
  "address": {
    "street": "Erdberg",
    "houseNumber": "2",
    "stairway": "1",
    "door": "20",
    "postalCode": 1010,
    "city": "Wien"
  },
  "telephoneNumber": "00436645678953",
  "email": "eva.musterfrau@wrk.at",
  "validUntil": "2999-12-31",
  "persons": [
    {
      "isMainPerson": true,
      "firstname": "Eva",
      "lastname": "Musterfrau",
      "birthDate": "1990-01-01",
      "gender": "FEMALE",
      "country": {
        "id": 2,
        "code": "EG",
        "name": "Ägypten"
      },
      "employer": "Rotes Kreuz Wien",
      "income": 456.00,
      "incomeDue": "2999-12-31"
    },
    {
      "id": 1,
      "isMainPerson": false,
      "firstname": "Child 1",
      "lastname": "Musterfrau",
      "birthDate": "2000-01-01",
      "gender": "MALE",
      "income": 500,
      "country": {
        "id": 2,
        "code": "EG",
        "name": "Ägypten"
      }
    },
    {
      "id": 2,
      "isMainPerson": false,
      "firstname": "Child 2",
      "lastname": "Musterfrau",
      "birthDate": "2020-01-01",
      "income": 0,
      "country": {
        "id": 2,
        "code": "EG",
        "name": "Ägypten"
      }
    },
    {
      "id": 3,
      "isMainPerson": false,
      "firstname": "Child 3",
