### Get household 100
GET {{baseApiPath}}/households/100
Content-Type: application/json

### Delete household 100
DELETE {{baseApiPath}}/households/100
Content-Type: application/json

### Get masterdata pdf
GET {{baseApiPath}}/households/100/generate-pdf?type=MASTERDATA
Content-Type: application/json

### Get idcard pdf
GET {{baseApiPath}}/households/100/generate-pdf?type=IDCARD
Content-Type: application/json

### Get digital idcard (format: PDF, IMAGE, or WALLET - an unsigned .pkpass for Android)
GET {{baseApiPath}}/households/100/id-card?format=IMAGE

### Send digital idcard by mail to the address stored on the household
POST {{baseApiPath}}/households/100/id-card/send-mail
Content-Type: application/json

{
  "formats": ["PDF", "IMAGE"]
}

### Get privacy notice pdf
GET {{baseApiPath}}/households/100/generate-pdf?type=PRIVACY_NOTICE
Content-Type: application/json

### Get privacy notice pdf (blank template, no household reference)
GET {{baseApiPath}}/households/privacy-notice-template
Content-Type: application/json

### Get duplicates
GET {{baseApiPath}}/households/duplicates
Content-Type: application/json

### Get households above limit
GET {{baseApiPath}}/households/above-limit
Content-Type: application/json

### Get locked households (optionally only the ones without an end date, or the ones due for review)
GET {{baseApiPath}}/households/locked?page=1&pageSize=10&openEndedOnly=false&dueOnly=false
Content-Type: application/json

### Confirm that a lock stays (restarts its review interval)
POST {{baseApiPath}}/households/100/lock-review
Content-Type: application/json

### Lock a household (only the lock is sent, never the household itself)
POST {{baseApiPath}}/households/100/lock
Content-Type: application/json

{
  "lockReason": "Grund der Sperre",
  "lockReasonType": "OTHER",
  "lockedUntil": null
}

### Prolong a household by a number of months (force=true: supervisor override for an above-limit income)
POST {{baseApiPath}}/households/100/prolong?force=false
Content-Type: application/json

{
  "months": 3
}

### Deactivate a household (valid until yesterday)
POST {{baseApiPath}}/households/100/deactivate
Content-Type: application/json

### Unlock a household
POST {{baseApiPath}}/households/100/unlock
Content-Type: application/json

### Get new/renewed households overview of the latest distribution
GET {{baseApiPath}}/households/overview
Content-Type: application/json

### Get new/renewed households overview of a specific distribution
GET {{baseApiPath}}/households/overview?distributionId=100
Content-Type: application/json

### Preview merging households into another one
GET {{baseApiPath}}/households/100/merge-preview?sourceHouseholdIds=102&sourceHouseholdIds=103
Content-Type: application/json

### Merge households into another one, picking source 102's telephone number and address
POST {{baseApiPath}}/households/100/merge
Content-Type: application/json

{
  "sourceHouseholdIds": [
    102,
    103
  ],
  "fieldSelections": [
    {
      "field": "TELEPHONE_NUMBER",
      "sourceHouseholdId": 102
    },
    {
      "field": "ADDRESS",
      "sourceHouseholdId": 102
    }
  ]
}
