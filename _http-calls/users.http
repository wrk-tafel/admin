### Login
POST {{baseApiPath}}/login
Authorization: Basic {{encodedCredentials}}

### Login fails - user not found
POST {{baseApiPath}}/login
Authorization: Basic d3Jvbmc6d3Jvbmc=

### Login fails - wrong password
POST {{baseApiPath}}/login
Authorization: Basic YWRtaW46d3Jvbmc=

### Change password
POST {{baseApiPath}}/users/change-password
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "passwordCurrent": "12345",
  "passwordNew": "wrk-tafel"
}

### Logout
POST {{baseApiPath}}/users/logout

### Get info of the currently authenticated user
GET {{baseApiPath}}/users/info

### Get the own account ("Mein Konto" > "Meine Daten")
GET {{baseApiPath}}/users/account

### Update the own account - name and e-mail only, username and personnel number stay with the administrator
PUT {{baseApiPath}}/users/account
Content-Type: application/json

{
  "firstname": "Max",
  "lastname": "Mustermann",
  "email": "max.mustermann@example.org"
}

### Change the e-mail address while the e-mail method of two-factor authentication is on
# The address is where the login codes go, so a code of a method the user has (mfaCode) is required.
PUT {{baseApiPath}}/users/account
Content-Type: application/json

{
  "firstname": "Max",
  "lastname": "Mustermann",
  "email": "max.neu@example.org",
  "mfaCode": "123456"
}

### Search for users (username, name or personnel number - fuzzy)
# The term goes in the body, not a ?searchInput=... query parameter - see ADR-0057 (GDPR gap G25).
POST {{baseApiPath}}/users/search
Content-Type: application/json

{
  "searchInput": "muster"
}

### Search for users (fuzzy search combined with the filter)
POST {{baseApiPath}}/users/search
Content-Type: application/json

{
  "searchInput": "muster",
  "enabled": true
}

### Search for users (enabled)
POST {{baseApiPath}}/users/search
Content-Type: application/json

{
  "enabled": true
}

### Get user 300
GET {{baseApiPath}}/users/300
Content-Type: application/json

### Get user admin by personnel-number
GET {{baseApiPath}}/users/personnel-number/admin-persnr
Content-Type: application/json

### Create user
POST {{baseApiPath}}/users
Content-Type: application/json

{
  "personnelNumber": "0400",
  "username": "new-user",
  "firstname": "New",
  "lastname": "User",
  "email": "new-user@example.org",
  "enabled": true,
  "password": "12345",
  "passwordRepeat": "12345",
  "passwordChangeRequired": true,
  "permissions": []
}

### Update user
PUT {{baseApiPath}}/users/300
Content-Type: application/json

{
  "id": 300,
  "personnelNumber": "0300",
  "username": "admin",
  "firstname": "AD",
  "lastname": "min",
  "email": null,
  "enabled": false,
  "password": "12345",
  "passwordRepeat": "12345",
  "passwordChangeRequired": true,
  "permissions": []
}

### Delete user
DELETE {{baseApiPath}}/users/300

### Generate a random password
GET {{baseApiPath}}/users/generate-password
Content-Type: application/json

### Get all available permissions
GET {{baseApiPath}}/users/permissions
Content-Type: application/json

### Get login attempts
POST {{baseApiPath}}/users/login-attempts/search
Content-Type: application/json

{}

### Get login attempts of a searched username, currently locked ones only
POST {{baseApiPath}}/users/login-attempts/search
Content-Type: application/json

{
  "searchInput": "hans",
  "lockedOnly": true
}

### Get the configured lockout rule
GET {{baseApiPath}}/users/login-attempts/settings

### Delete login attempt 1
DELETE {{baseApiPath}}/users/login-attempts/1
